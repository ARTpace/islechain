// IsleChain 启动器的 Windows 资源脚本：应用图标 + 版本信息。
// 编译由 build.rs 通过 embed-resource 完成（内部调用 Windows SDK 的 rc.exe）。
// 必须 include winres.h：VS_VERSION_INFO / VOS_NT_WINDOWS32 / VFT_APP 等常量都定义在里面，
// 裸写会得到 "RC.EXE failed to compile specified resource file"。

#include <winres.h>

1 ICON "icon.ico"

VS_VERSION_INFO VERSIONINFO
 FILEVERSION 1,0,0,0
 PRODUCTVERSION 1,0,0,0
 FILEFLAGSMASK 0x3fL
 FILEFLAGS 0x0L
 FILEOS VOS_NT_WINDOWS32
 FILETYPE VFT_APP
 FILESUBTYPE 0x0L
BEGIN
    BLOCK "StringFileInfo"
    BEGIN
        BLOCK "040904b0"
        BEGIN
            VALUE "CompanyName", "IsleChain\0"
            VALUE "FileDescription", "IsleChain desktop launcher\0"
            VALUE "FileVersion", "1.0.0.0\0"
            VALUE "InternalName", "IsleChain\0"
            VALUE "OriginalFilename", "IsleChain.exe\0"
            VALUE "ProductName", "IsleChain\0"
            VALUE "ProductVersion", "1.0.0.0\0"
        END
    END
    BLOCK "VarFileInfo"
    BEGIN
        VALUE "Translation", 0x409, 1200
    END
END
